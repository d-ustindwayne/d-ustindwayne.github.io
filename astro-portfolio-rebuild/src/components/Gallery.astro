---
import { lang } from "./Config.astro";
import textContent from "../data/textContent.json";
import photoList from "../data/photos.json";
import PhotoFilm from "./PhotoFilm.astro";
import { type PhotoData } from "../types/PhotoType.astro";
const photos: PhotoData[] = photoList[lang].slice(1);
const photosDir: string = "/gallery";
---

<section>
    <h2 class="text-4xl font-bold my-8 underline decoration-wavy decoration-green-400">{textContent[lang].gallery.title}</h2>
    <p class="mb-6 text-xl">{textContent[lang].gallery.sublabel}</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {photos.map((photo)=> <PhotoFilm imageUrl={`${photosDir}${photo.src}`} imageAlt={photo.alt}>{photo.caption}</PhotoFilm>)}
    </div>
</section>