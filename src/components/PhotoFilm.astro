---
import { Image, getImage } from "astro:assets";
import { getContent } from "../i18n";
import type { ImageMetadata } from "astro";

interface Props {
    src: ImageMetadata;
    alt: string;
    class?: string;
    imageClass?: string;
    tilt?: string;
    loading?: "eager" | "lazy";
}

const rotations = ["rotate-2", "-rotate-2", "rotate-3", "-rotate-3", "-rotate-1"];
const {
    src,
    alt,
    class: cls,
    imageClass = "aspect-4/3 w-full",
    tilt = `${rotations[Math.floor(Math.random() * rotations.length)]} hover:rotate-0`,
    loading = "lazy",
} = Astro.props;

// Clicking the photo opens it larger in the shared PhotoModal
const { ui } = getContent(Astro.currentLocale);
const full = await getImage({ src, width: Math.min(src.width, 1600) });
const caption = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
---

<figure class:list={["tape relative bg-card p-2.5 shadow-md transition-transform duration-300", tilt, cls]}>
    <button type="button" data-dialog="photo-modal" data-photo={full.src} data-alt={alt} data-caption={caption} aria-label={ui.gallery.enlarge} class="block">
        <Image src={src} alt={alt} widths={[320, 640]} sizes="(min-width: 768px) 280px, (min-width: 384px) 45vw, 90vw" loading={loading} class:list={["object-cover", imageClass]} />
    </button>
    {Astro.slots.has("default") && (
        <figcaption class="mt-2 text-center text-sm font-bold text-muted">
            <slot />
        </figcaption>
    )}
</figure>
