---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    src: ImageMetadata;
    alt: string;
    class?: string;
    imageClass?: string;
    tilt?: string;
    loading?: "eager" | "lazy";
}

const rotations = ["rotate-2", "-rotate-2", "rotate-3", "-rotate-3", "-rotate-1"];
const {
    src,
    alt,
    class: cls,
    imageClass = "aspect-4/3 w-full",
    tilt = `${rotations[Math.floor(Math.random() * rotations.length)]} hover:rotate-0`,
    loading = "lazy",
} = Astro.props;
---

<figure class:list={["tape relative bg-card p-2.5 shadow-md transition-transform duration-300", tilt, cls]}>
    <Image src={src} alt={alt} widths={[320, 640]} sizes="(min-width: 768px) 280px, (min-width: 384px) 45vw, 90vw" loading={loading} class:list={["object-cover", imageClass]} />
    {Astro.slots.has("default") && (
        <figcaption class="mt-2 text-center text-sm font-bold text-muted">
            <slot />
        </figcaption>
    )}
</figure>
