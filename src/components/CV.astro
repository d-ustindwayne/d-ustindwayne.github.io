---
import CVFace from "./CVFace.astro";
import { getContent } from "../i18n";

const { ui } = getContent(Astro.currentLocale);
---

<section id="cv" class="mb-10 scroll-mt-8">
    <div class="mb-10 text-center print:hidden">
        <h2 class="my-5 text-4xl font-bold underline decoration-purple-400 decoration-wavy">{ui.cv.title}</h2>
        <p class="mt-2 text-muted">({ui.cv.sublabel})</p>
    </div>

    <!-- Both faces share one grid cell, so the card is as tall as its longest side -->
    <div class="mx-auto max-w-2xl perspective-[1500px]">
        <div id="cv-card" class="grid cursor-pointer transition-transform duration-800 ease-[cubic-bezier(0.175,0.885,0.32,1.275)] transform-3d data-flipped:rotate-y-180 motion-reduce:transition-none">
            <CVFace side="front" />
            <CVFace side="back" />
        </div>
    </div>
</section>

<script>
    const card = document.getElementById("cv-card")!;
    const [front, back] = card.querySelectorAll<HTMLElement>("[data-face]");

    card.addEventListener("click", () => {
        if (getSelection()?.toString()) return; // let people select text without flipping
        const flipped = card.toggleAttribute("data-flipped");
        front.inert = flipped;
        back.inert = !flipped;
        (flipped ? back : front).querySelector("button")?.focus({ preventScroll: true });
    });

    // Printing always uses the light theme
    const root = document.documentElement;
    let theme: string | undefined;

    addEventListener("beforeprint", () => {
        theme = root.dataset.theme;
        root.dataset.theme = "light";
    });
    addEventListener("afterprint", () => {
        if (theme) root.dataset.theme = theme;
        theme = undefined;
    });
</script>

<style is:global>
    /* Printing the home page prints just the CV: the front, then the dark side on its own page */
    @media print {
        @page {
            margin: 12mm;
        }
        body:has(#cv-card) {
            background: none;
            & > :not(main),
            & main > :not(#cv) {
                display: none !important;
            }
            & main {
                padding: 0;
            }
            & #cv {
                margin: 0;
                zoom: 0.72; /* each side fits on one A4 page */
            }
            & #cv-card {
                display: block;
                transform: none;
            }
            & [data-face] {
                transform: none;
                box-shadow: none;
                backface-visibility: visible;
                print-color-adjust: exact;
            }
            & [data-face="back"] {
                break-before: page;
            }
            & [data-face] button {
                display: none;
            }
        }
    }
</style>
