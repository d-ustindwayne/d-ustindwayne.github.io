---
import { getContent } from "../i18n";

const { ui } = getContent(Astro.currentLocale);
---

<footer id="contact" class="text-center text-muted">
    <p>
        &copy; {new Date().getFullYear()} <Fragment set:html={ui.footer.text} /><br />
        <Fragment set:html={ui.footer.secondLine} />
    </p>
    <p class="mt-3 text-base text-faint">
        GitHub:
        <a href="https://github.com/d-ustindwayne" target="_blank" rel="noopener" class="text-blue-pen underline hover:text-red-pen">@d-ustindwayne</a>
        <span>(this is not <a href="https://github.com/dustindwayne" target="_blank" rel="noopener" class="text-blue-pen underline hover:text-red-pen">@dustindwayne</a>)</span>
    </p>
</footer>
