---
import Layout from "../layouts/Layout.astro";
import SketchBox from "../components/SketchBox.astro";
import SketchButton from "../components/SketchButton.astro";
---

<Layout title="404 - Page Not Found">
    <main class="grid min-h-dvh place-items-center px-5">
        <SketchBox class="max-w-md p-8 text-center">
            <h1 class="mb-2 text-6xl font-bold"><span class="highlight">404</span></h1>
            <p class="mb-6 text-muted">The page you are looking for does not exist.</p>
            <SketchButton href="/" variant="solid">Go home</SketchButton>
        </SketchBox>
    </main>
</Layout>
